# LexAI frontend - environment template.
# Copy to .env (same directory) and fill in real values. Never commit .env.
# Vite only exposes variables that start with VITE_, and they end up in the browser bundle,
# so never put a secret here (the Supabase anon key is meant to be public; the service_role key is not).

# Your Supabase project URL (Supabase dashboard -> Project Settings -> API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon (public) key, same page. Never the service_role key.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Base URL of the LexAI backend (no trailing slash). Defaults to http://localhost:8000 if unset (local dev only).
VITE_API_URL=http://localhost:8000
