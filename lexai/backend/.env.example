# LexAI backend — environment template.
# Copy to .env (same directory) and fill in real values. Never commit .env.

# Which provider in _PROVIDERS (llm_client.py) to use as primary: "nvidia" or "groq".
LLM_PROVIDER=nvidia

# API key for the NVIDIA NIM OpenAI-compatible endpoint (required when LLM_PROVIDER=nvidia).
NVIDIA_API_KEY=your-nvidia-api-key-here

# API key for the Groq OpenAI-compatible endpoint (required when LLM_PROVIDER=groq, or when
# LLM_FALLBACK_PROVIDER=groq is used as the failover path; live Groq path untested).
GROQ_API_KEY=your-groq-api-key-here

# Optional: override the selected PRIMARY provider's default chat model (see _PROVIDERS).
# Leave unset to use the provider's default model.
LLM_MODEL=openai/gpt-oss-20b

# Optional: per-call timeout in seconds for each LLM provider request (float; default 30).
LLM_TIMEOUT_S=30

# Optional: provider to fail over to if the primary times out or errors ("nvidia" or "groq";
# default "groq"; set to an empty string to disable failover entirely). Only used if that
# provider's own API-key env var above is set.
LLM_FALLBACK_PROVIDER=groq

# Optional: override the fallback provider's default chat model. Leave unset to use its default.
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional: embedding model for Chroma (local sentence-transformers model name).
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional: cross-encoder reranker model (local sentence-transformers model name).
RERANK_MODEL=BAAI/bge-reranker-base

# Optional: directory where the Chroma persistent store lives, relative to lexai_engine.py.
CHROMA_PERSIST_DIR=./chroma_store

# Optional: Layer 6 confidence gate threshold (0.0-1.0); below this the query is refused.
CONFIDENCE_THRESHOLD=0.30

# Optional: comma-separated list of origins allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:5173
