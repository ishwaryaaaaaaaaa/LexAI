# LexAI backend — environment template.
# Copy to .env (same directory) and fill in real values. Never commit .env.

# Which provider in _PROVIDERS (lexai_engine.py) to use: "nvidia" or "groq".
LLM_PROVIDER=nvidia

# API key for the NVIDIA NIM OpenAI-compatible endpoint (required when LLM_PROVIDER=nvidia).
NVIDIA_API_KEY=your-nvidia-api-key-here

# API key for the Groq OpenAI-compatible endpoint (required when LLM_PROVIDER=groq; untested).
GROQ_API_KEY=your-groq-api-key-here

# Optional: override the selected provider's default chat model (see _PROVIDERS).
# Leave unset to use the provider's default model.
LLM_MODEL=openai/gpt-oss-20b

# Optional: embedding model for Chroma (local sentence-transformers model name).
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional: cross-encoder reranker model (local sentence-transformers model name).
RERANK_MODEL=BAAI/bge-reranker-base

# Optional: directory where the Chroma persistent store lives, relative to lexai_engine.py.
CHROMA_PERSIST_DIR=./chroma_store

# Optional: Layer 6 confidence gate threshold (0.0-1.0); below this the query is refused.
CONFIDENCE_THRESHOLD=0.30

# Optional: comma-separated list of origins allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:5173
